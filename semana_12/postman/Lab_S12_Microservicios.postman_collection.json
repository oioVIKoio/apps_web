    {
      "name": "4. Pedido (Feign a cliente y producto)",
      "item": [
        {
          "name": "Registrar pedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{pedido}}/api/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\n \"clienteId\":{{clienteId}},\n \"productoId\":{{productoId}},\n \"cantidad\":2\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"pedidoId\", pm.response.json().id);",
                  "pm.test(\"Empieza PENDIENTE\", () => pm.expect(pm.response.json().estado).to.eql(\"PENDIENTE\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar pedido completo",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{pedido}}/api/pedidos/{{pedidoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Datos del pedido\", () => { pm.expect(j.id).to.eql(pm.collectionVariables.get(\"pedidoId\")); pm.expect(j.cantidad).to.eql(2); });",
                  "pm.test(\"Datos del cliente (cliente-service)\", () => { pm.expect(j.cliente.nombre).to.eql(\"Carlos\"); pm.expect(j.cliente.apellido).to.eql(\"Ramirez\"); });",
                  "pm.test(\"Datos del producto (producto-service)\", () => { pm.expect(j.producto.nombre).to.eql(\"Laptop\"); pm.expect(j.producto.precio).to.eql(2500); });"
                ]
              }
            }
          ]
        },
