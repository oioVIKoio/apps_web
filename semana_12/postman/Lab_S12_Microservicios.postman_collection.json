{
  "info": {
    "name": "Lab S12 - Comunicación entre microservicios",
    "description": "Eureka + OpenFeign: categoría, producto, cliente y pedido. Levantar primero eureka-server y luego los 4 servicios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Categoría",
      "item": [
        {
          "name": "Registrar categoría",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{categoria}}/api/categorias",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Tecnología\",\n  \"estado\": \"ACTIVO\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"categoriaId\", pm.response.json().id);",
                  "pm.test(\"Nombre guardado\", () => pm.expect(pm.response.json().nombre).to.eql(\"Tecnología\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar categorías",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{categoria}}/api/categorias"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Es una lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\").that.is.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar categoría",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{categoria}}/api/categorias/{{categoriaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Error: categoría sin datos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{categoria}}/api/categorias",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"\",\n  \"estado\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Error en: nombre, estado\", () => { const j = pm.response.json(); pm.expect(j).to.have.property(\"nombre\"); pm.expect(j).to.have.property(\"estado\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Error: categoría que no existe",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{categoria}}/api/categorias/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Mensaje: Categoría no encontrada\", () => pm.expect(pm.response.json().mensaje).to.include(\"Categor\\u00eda no encontrada\"));"
                ]
              }
            }
          ]
        }
      ]
    },
